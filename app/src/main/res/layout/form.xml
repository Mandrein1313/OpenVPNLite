<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111827"
        app:elevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:background="#111827">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="V"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/toolbar_logo_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VPN THAI"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:paddingStart="10dp"
                    android:paddingLeft="10dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/toolbar_log"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_info_details"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Log"
                app:tint="#E5E7EB" />
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="72dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- โปรไฟล์แบบการ์ด -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/profile_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#2C2C2E"
                app:strokeWidth="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@+id/profile_edit"
                        android:layout_toLeftOf="@+id/profile_edit"
                        android:orientation="vertical"
                        android:layout_centerVertical="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_prompt"
                            android:textSize="12sp"
                            android:textColor="#9CA3AF"
                            android:paddingBottom="6dp" />

                        <TextView
                            android:id="@+id/profile_name_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เลือกโปรไฟล์"
                            android:textSize="15sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/profile_edit"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/edit"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="แก้ไขโปรไฟล์"
                        app:tint="#F59E0B" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Spinner ซ่อนไว้ ให้ Java เดิมใช้ต่อได้ -->
            <Spinner
                android:id="@+id/profile"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- ปุ่มเชื่อมต่อ -->
            <LinearLayout
                android:id="@+id/button_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp"
                android:visibility="visible">

                <Button
                    android:id="@+id/connect"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="8dp"
                    android:text="CONNECT VPN"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_connect_bg"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:visibility="visible" />

                <Button
                    android:id="@+id/disconnect"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="DISCONNECT"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_disconnect_bg"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- สถานะ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#2C2C2E"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/status_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="สถานะ" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingLeft="12dp"
                    android:paddingStart="12dp"
                    android:textSize="14sp"
                    android:textColor="#E5E7EB" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                style="@android:style/Widget.ProgressBar.Horizontal" />

            <!-- post import (ซ่อน) -->
            <LinearLayout
                android:id="@+id/post_import_help_blurb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- พร็อกซี่ -->
            <RelativeLayout
                android:id="@+id/proxy_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2C2C2E"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/proxy_edit"
                    android:layout_toStartOf="@+id/proxy_edit"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/proxy_prompt"
                        android:textSize="12sp"
                        android:textColor="#9CA3AF"
                        android:paddingBottom="6dp" />

                    <Spinner
                        android:id="@+id/proxy"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#3F3F46"
                        android:popupBackground="#2C2C2E" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/proxy_edit"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/edit"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="แก้ไขพร็อกซี่"
                    app:tint="#F59E0B" />
            </RelativeLayout>

            <!-- เซิร์ฟเวอร์ -->
            <LinearLayout
                android:id="@+id/server_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2C2C2E"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/server_prompt"
                    android:textSize="12sp"
                    android:textColor="#9CA3AF"
                    android:paddingBottom="6dp" />

                <Spinner
                    android:id="@+id/server"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#3F3F46"
                    android:popupBackground="#2C2C2E" />
            </LinearLayout>

            <!-- Username -->
            <LinearLayout
                android:id="@+id/username_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2C2C2E"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/username"
                    android:textSize="12sp"
                    android:textColor="#9CA3AF"
                    android:paddingBottom="6dp" />

                <EditText
                    android:id="@+id/username"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#3F3F46"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6B7280"
                    android:inputType="text" />
            </LinearLayout>

            <!-- PK Password -->
            <LinearLayout
                android:id="@+id/pk_password_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2C2C2E"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pk_password"
                    android:textSize="12sp"
                    android:textColor="#9CA3AF"
                    android:paddingBottom="6dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/pk_password"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_toLeftOf="@+id/pk_password_save"
                        android:layout_toStartOf="@+id/pk_password_save"
                        android:background="#3F3F46"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#6B7280"
                        android:inputType="textPassword" />

                    <CheckBox
                        android:id="@+id/pk_password_save"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="@string/pk_password_save_prompt"
                        android:textSize="12sp"
                        android:textColor="#E5E7EB"
                        android:buttonTint="#F59E0B" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Password -->
            <LinearLayout
                android:id="@+id/password_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2C2C2E"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/password"
                    android:textSize="12sp"
                    android:textColor="#9CA3AF"
                    android:paddingBottom="6dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_toLeftOf="@+id/password_save"
                        android:layout_toStartOf="@+id/password_save"
                        android:background="#3F3F46"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#6B7280"
                        android:inputType="textPassword" />

                    <CheckBox
                        android:id="@+id/password_save"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="@string/password_save_prompt"
                        android:textSize="12sp"
                        android:textColor="#E5E7EB"
                        android:buttonTint="#F59E0B" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Challenge / Response -->
            <LinearLayout
                android:id="@+id/cr_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2C2C2E"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/challenge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#E5E7EB"
                    android:paddingBottom="8dp" />

                <EditText
                    android:id="@+id/response"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#3F3F46"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6B7280" />
            </LinearLayout>

            <!-- สถิติ -->
            <LinearLayout
                android:id="@+id/conn_details_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/conn_details_boxed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#2C2C2E"
                    android:padding="14dp">

                    <LinearLayout
                        android:id="@+id/stats_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_group_header"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#F59E0B"
                            android:paddingBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="8dp"
                                android:layout_marginEnd="4dp"
                                android:background="#3F3F46">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="เวลา"
                                    android:textSize="10sp"
                                    android:textColor="#9CA3AF" />

                                <TextView
                                    android:id="@+id/duration"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0:00:00"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:paddingTop="2dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="8dp"
                                android:layout_marginStart="2dp"
                                android:layout_marginEnd="2dp"
                                android:background="#3F3F46">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="↓ รับ"
                                    android:textSize="10sp"
                                    android:textColor="#9CA3AF" />

                                <TextView
                                    android:id="@+id/bytes_in"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:paddingTop="2dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="8dp"
                                android:layout_marginStart="4dp"
                                android:background="#3F3F46">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="↑ ส่ง"
                                    android:textSize="10sp"
                                    android:textColor="#9CA3AF" />

                                <TextView
                                    android:id="@+id/bytes_out"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:paddingTop="2dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="8dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/last_pkt_recv"
                                android:textSize="11sp"
                                android:textColor="#6B7280" />

                            <TextView
                                android:id="@+id/last_pkt_recv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="11sp"
                                android:textColor="#9CA3AF" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/stats_expansion_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingTop="10dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#3F3F46"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:id="@+id/info_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/info_group_header"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#F59E0B"
                                android:paddingBottom="8dp" />

                            <TableLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:stretchColumns="1">

                                <TableRow android:id="@+id/ipv4_addr_row">
                                    <TextView android:text="@string/ipv4_addr" android:textColor="#9CA3AF" android:textSize="12sp" android:padding="4dp" />
                                    <TextView android:id="@+id/ipv4_addr" android:textColor="#FFFFFF" android:textSize="12sp" android:padding="4dp" />
                                </TableRow>
                                <TableRow android:id="@+id/ipv6_addr_row">
                                    <TextView android:text="@string/ipv6_addr" android:textColor="#9CA3AF" android:textSize="12sp" android:padding="4dp" />
                                    <TextView android:id="@+id/ipv6_addr" android:textColor="#FFFFFF" android:textSize="12sp" android:padding="4dp" />
                                </TableRow>
                                <TableRow android:id="@+id/user_row">
                                    <TextView android:text="@string/user" android:textColor="#9CA3AF" android:textSize="12sp" android:padding="4dp" />
                                    <TextView android:id="@+id/user" android:textColor="#FFFFFF" android:textSize="12sp" android:padding="4dp" />
                                </TableRow>
                                <TableRow android:id="@+id/client_ip_row">
                                    <TextView android:text="@string/client_ip" android:textColor="#9CA3AF" android:textSize="12sp" android:padding="4dp" />
                                    <TextView android:id="@+id/client_ip" android:textColor="#FFFFFF" android:textSize="12sp" android:padding="4dp" />
                                </TableRow>
                                <TableRow android:id="@+id/server_host_row">
                                    <TextView android:text="@string/server_host" android:textColor="#9CA3AF" android:textSize="12sp" android:padding="4dp" />
                                    <TextView android:id="@+id/server_host" android:textColor="#FFFFFF" android:textSize="12sp" android:padding="4dp" />
                                </TableRow>
                                <TableRow android:id="@+id/server_ip_row">
                                    <TextView android:text="@string/server_ip" android:textColor="#9CA3AF" android:textSize="12sp" android:padding="4dp" />
                                    <TextView android:id="@+id/server_ip" android:textColor="#FFFFFF" android:textSize="12sp" android:padding="4dp" />
                                </TableRow>
                                <TableRow android:id="@+id/server_port_row">
                                    <TextView android:text="@string/server_port" android:textColor="#9CA3AF" android:textSize="12sp" android:padding="4dp" />
                                    <TextView android:id="@+id/server_port" android:textColor="#FFFFFF" android:textSize="12sp" android:padding="4dp" />
                                </TableRow>
                                <TableRow android:id="@+id/server_proto_row">
                                    <TextView android:text="@string/server_proto" android:textColor="#9CA3AF" android:textSize="12sp" android:padding="4dp" />
                                    <TextView android:id="@+id/server_proto" android:textColor="#FFFFFF" android:textSize="12sp" android:padding="4dp" />
                                </TableRow>
                            </TableLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/details_more_less"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:paddingTop="10dp"
                        android:textSize="12sp"
                        android:textColor="#F59E0B" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ด้านล่างเหมือนเดิม -->
    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:backgroundTint="#111827"
        app:fabCradleMargin="14dp"
        app:fabCradleRoundedCornerRadius="16dp"
        app:fabCradleVerticalOffset="4dp"
        app:fabAlignmentMode="end"
        app:menu="@menu/bottom_menu" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="เมนู"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#EF4444"
        app:tint="#FFFFFF"
        app:layout_anchor="@id/bottom_bar" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
