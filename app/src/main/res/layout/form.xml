<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">

    <ScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="72dp"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- โปรไฟล์ -->
            <LinearLayout
                android:id="@+id/profile_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_prompt"
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:paddingBottom="6dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Spinner
                        android:id="@+id/profile"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_toLeftOf="@+id/profile_edit"
                        android:layout_toStartOf="@+id/profile_edit"
                        android:background="#F3F4F6"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:focusable="false" />

                    <ImageButton
                        android:id="@+id/profile_edit"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/edit"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="แก้ไขโปรไฟล์" />
                </RelativeLayout>
            </LinearLayout>

            <!-- ปุ่มเชื่อมต่อ -->
            <LinearLayout
                android:id="@+id/button_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp"
                android:visibility="visible">

                <Button
                    android:id="@+id/connect"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="8dp"
                    android:text="เชื่อมต่อ"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:background="#0EA5E9"
                    android:visibility="visible" />

                <Button
                    android:id="@+id/disconnect"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="ตัดการเชื่อมต่อ"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:background="#DC2626"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- สถานะ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@android:color/white"
                android:padding="14dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp">

                <ImageView
                    android:id="@+id/status_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="สถานะ" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingLeft="12dp"
                    android:paddingStart="12dp"
                    android:textSize="14sp"
                    android:textColor="#374151" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                style="@android:style/Widget.ProgressBar.Horizontal" />

            <!-- post import (ซ่อน) -->
            <LinearLayout
                android:id="@+id/post_import_help_blurb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- พร็อกซี่ -->
            <RelativeLayout
                android:id="@+id/proxy_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/proxy_edit"
                    android:layout_toStartOf="@+id/proxy_edit"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/proxy_prompt"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:paddingBottom="6dp" />

                    <Spinner
                        android:id="@+id/proxy"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#F3F4F6" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/proxy_edit"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/edit"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="แก้ไขพร็อกซี่" />
            </RelativeLayout>

            <!-- เซิร์ฟเวอร์ -->
            <LinearLayout
                android:id="@+id/server_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/server_prompt"
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:paddingBottom="6dp" />

                <Spinner
                    android:id="@+id/server"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#F3F4F6" />
            </LinearLayout>

            <!-- Username -->
            <LinearLayout
                android:id="@+id/username_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/username"
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:paddingBottom="6dp" />

                <EditText
                    android:id="@+id/username"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#F3F4F6"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:textSize="15sp"
                    android:inputType="text" />
            </LinearLayout>

            <!-- PK Password -->
            <LinearLayout
                android:id="@+id/pk_password_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pk_password"
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:paddingBottom="6dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/pk_password"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_toLeftOf="@+id/pk_password_save"
                        android:layout_toStartOf="@+id/pk_password_save"
                        android:background="#F3F4F6"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:inputType="textPassword" />

                    <CheckBox
                        android:id="@+id/pk_password_save"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="@string/pk_password_save_prompt"
                        android:textSize="12sp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Password -->
            <LinearLayout
                android:id="@+id/password_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/password"
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:paddingBottom="6dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_toLeftOf="@+id/password_save"
                        android:layout_toStartOf="@+id/password_save"
                        android:background="#F3F4F6"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:inputType="textPassword" />

                    <CheckBox
                        android:id="@+id/password_save"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="@string/password_save_prompt"
                        android:textSize="12sp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Challenge / Response -->
            <LinearLayout
                android:id="@+id/cr_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/challenge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#374151"
                    android:paddingBottom="8dp" />

                <EditText
                    android:id="@+id/response"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#F3F4F6"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp" />
            </LinearLayout>

            <!-- รายละเอียดการเชื่อมต่อ / สถิติ -->
            <LinearLayout
                android:id="@+id/conn_details_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/conn_details_boxed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@android:color/white"
                    android:padding="16dp"
                    android:elevation="2dp">

                    <LinearLayout
                        android:id="@+id/stats_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_group_header"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#0EA5E9"
                            android:paddingBottom="10dp" />

                        <TableLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:stretchColumns="1">

                            <TableRow>
                                <TextView
                                    android:text="@string/duration"
                                    android:textColor="#6B7280"
                                    android:textSize="13sp"
                                    android:padding="6dp" />
                                <TextView
                                    android:id="@+id/duration"
                                    android:textColor="#111827"
                                    android:textSize="13sp"
                                    android:padding="6dp" />
                            </TableRow>
                            <TableRow>
                                <TextView
                                    android:text="@string/last_pkt_recv"
                                    android:textColor="#6B7280"
                                    android:textSize="13sp"
                                    android:padding="6dp" />
                                <TextView
                                    android:id="@+id/last_pkt_recv"
                                    android:textColor="#111827"
                                    android:textSize="13sp"
                                    android:padding="6dp" />
                            </TableRow>
                            <TableRow>
                                <TextView
                                    android:text="@string/bytes_in"
                                    android:textColor="#6B7280"
                                    android:textSize="13sp"
                                    android:padding="6dp" />
                                <TextView
                                    android:id="@+id/bytes_in"
                                    android:textColor="#111827"
                                    android:textSize="13sp"
                                    android:padding="6dp" />
                            </TableRow>
                            <TableRow>
                                <TextView
                                    android:text="@string/bytes_out"
                                    android:textColor="#6B7280"
                                    android:textSize="13sp"
                                    android:padding="6dp" />
                                <TextView
                                    android:id="@+id/bytes_out"
                                    android:textColor="#111827"
                                    android:textSize="13sp"
                                    android:padding="6dp" />
                            </TableRow>
                        </TableLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/stats_expansion_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/info_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/info_group_header"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#0EA5E9"
                                android:paddingTop="14dp"
                                android:paddingBottom="10dp" />

                            <TableLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:stretchColumns="1">

                                <TableRow android:id="@+id/ipv4_addr_row">
                                    <TextView android:text="@string/ipv4_addr" android:textColor="#6B7280" android:textSize="13sp" android:padding="6dp" />
                                    <TextView android:id="@+id/ipv4_addr" android:textColor="#111827" android:textSize="13sp" android:padding="6dp" />
                                </TableRow>
                                <TableRow android:id="@+id/ipv6_addr_row">
                                    <TextView android:text="@string/ipv6_addr" android:textColor="#6B7280" android:textSize="13sp" android:padding="6dp" />
                                    <TextView android:id="@+id/ipv6_addr" android:textColor="#111827" android:textSize="13sp" android:padding="6dp" />
                                </TableRow>
                                <TableRow android:id="@+id/user_row">
                                    <TextView android:text="@string/user" android:textColor="#6B7280" android:textSize="13sp" android:padding="6dp" />
                                    <TextView android:id="@+id/user" android:textColor="#111827" android:textSize="13sp" android:padding="6dp" />
                                </TableRow>
                                <TableRow android:id="@+id/client_ip_row">
                                    <TextView android:text="@string/client_ip" android:textColor="#6B7280" android:textSize="13sp" android:padding="6dp" />
                                    <TextView android:id="@+id/client_ip" android:textColor="#111827" android:textSize="13sp" android:padding="6dp" />
                                </TableRow>
                                <TableRow android:id="@+id/server_host_row">
                                    <TextView android:text="@string/server_host" android:textColor="#6B7280" android:textSize="13sp" android:padding="6dp" />
                                    <TextView android:id="@+id/server_host" android:textColor="#111827" android:textSize="13sp" android:padding="6dp" />
                                </TableRow>
                                <TableRow android:id="@+id/server_ip_row">
                                    <TextView android:text="@string/server_ip" android:textColor="#6B7280" android:textSize="13sp" android:padding="6dp" />
                                    <TextView android:id="@+id/server_ip" android:textColor="#111827" android:textSize="13sp" android:padding="6dp" />
                                </TableRow>
                                <TableRow android:id="@+id/server_port_row">
                                    <TextView android:text="@string/server_port" android:textColor="#6B7280" android:textSize="13sp" android:padding="6dp" />
                                    <TextView android:id="@+id/server_port" android:textColor="#111827" android:textSize="13sp" android:padding="6dp" />
                                </TableRow>
                                <TableRow android:id="@+id/server_proto_row">
                                    <TextView android:text="@string/server_proto" android:textColor="#6B7280" android:textSize="13sp" android:padding="6dp" />
                                    <TextView android:id="@+id/server_proto" android:textColor="#111827" android:textSize="13sp" android:padding="6dp" />
                                </TableRow>
                            </TableLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/details_more_less"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:paddingTop="12dp"
                        android:textSize="13sp"
                        android:textColor="#0EA5E9" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:backgroundTint="#111827"
        app:fabCradleMargin="14dp"
        app:fabCradleRoundedCornerRadius="16dp"
        app:fabCradleVerticalOffset="4dp"
        app:fabAlignmentMode="end"
        app:menu="@menu/bottom_menu" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="เมนู"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#EF4444"
        app:tint="#FFFFFF"
        app:layout_anchor="@id/bottom_bar" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>