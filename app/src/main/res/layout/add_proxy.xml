<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:id="@+id/proxy_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/proxy_title_add"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ใช้ตอนเชื่อมต่อ VPN ผ่าน HTTP Proxy"
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:paddingBottom="16dp" />

        <!-- Card: Server -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="เซิร์ฟเวอร์"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0EA5E9"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/proxy_friendly_name_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ชื่อพร็อกซี่ (ไม่บังคับ)"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/proxy_friendly_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F3F4F6"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textSize="15sp"
                android:textColor="#111827"
                android:hint="เช่น Proxy สำนักงาน"
                android:textColorHint="#9CA3AF"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusDown="@+id/proxy_host"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/proxy_host_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="โฮสต์ / IP *"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/proxy_host"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F3F4F6"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textSize="15sp"
                android:textColor="#111827"
                android:hint="proxy.example.com"
                android:textColorHint="#9CA3AF"
                android:inputType="textUri"
                android:imeOptions="actionNext"
                android:nextFocusDown="@+id/proxy_port"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/proxy_port_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="พอร์ต *"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/proxy_port"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F3F4F6"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textSize="15sp"
                android:textColor="#111827"
                android:hint="8080"
                android:textColorHint="#9CA3AF"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:nextFocusDown="@+id/proxy_username" />
        </LinearLayout>

        <!-- Card: Auth -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="การยืนยันตัวตน"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0EA5E9"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/proxy_username_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/proxy_username"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F3F4F6"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textSize="15sp"
                android:textColor="#111827"
                android:hint="ชื่อผู้ใช้ (ถ้ามี)"
                android:textColorHint="#9CA3AF"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusDown="@+id/proxy_password"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/proxy_password_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/proxy_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F3F4F6"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textSize="15sp"
                android:textColor="#111827"
                android:hint="รหัสผ่าน (ถ้ามี)"
                android:textColorHint="#9CA3AF"
                android:inputType="textPassword"
                android:imeOptions="actionNext"
                android:nextFocusDown="@+id/proxy_user_agent" />
        </LinearLayout>

        <!-- Card: Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Header เสริม"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0EA5E9"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/proxy_user_agent_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="User-Agent (ไม่บังคับ)"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/proxy_user_agent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:background="#F3F4F6"
                android:padding="14dp"
                android:textSize="14sp"
                android:textColor="#111827"
                android:hint="Mozilla/5.0 ..."
                android:textColorHint="#9CA3AF"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:imeOptions="actionDone" />
        </LinearLayout>

        <!-- Options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="12dp"
            android:layout_marginBottom="20dp"
            android:elevation="2dp">

            <CheckBox
                android:id="@+id/proxy_allow_cleartext_auth_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/proxy_allow_cleartext_auth_checkbox"
                android:textSize="14sp"
                android:textColor="#374151"
                android:padding="4dp" />
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:id="@+id/proxy_button_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/proxy_cancel_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/proxy_cancel_button"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textColor="#374151"
                android:background="#E5E7EB" />

            <Button
                android:id="@+id/proxy_save_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/proxy_save_button"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="#0EA5E9" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>