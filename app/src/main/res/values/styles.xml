<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ธีมหลักของแอป สด/มืด ทั้งหมด -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#121212</item>
        <item name="colorPrimary">#1F1B24</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">#F59E0B</item>

        <!-- ครอบคลุมหน้าตั้งค่า (Preference Screen) -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#9CA3AF</item>

        <!-- ครอบคลุม Dialog และ Popup ทุกชนิด -->
        <item name="dialogTheme">@style/CustomDarkDialog</item>
        <item name="alertDialogTheme">@style/CustomDarkDialog</item>
        <item name="android:dialogTheme">@style/CustomDarkDialog</item>
        <item name="android:alertDialogTheme">@style/CustomDarkDialog</item>
        
        <!-- ครอบคลุม Popup Menu และ List Context Menu -->
        <item name="popupTheme">@style/ThemeOverlay.AppCompat.Dark</item>
        <item name="android:popupMenuStyle">@style/CustomDarkPopupMenu</item>
        <item name="android:listPopupWindowStyle">@style/CustomDarkListPopup</item>
        <item name="listPopupWindowStyle">@style/CustomDarkListPopup</item>

        <!-- สี Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#111827</item>
    </style>

    <!-- สไตล์สำหรับ Alert Dialog / Pop-up -->
    <style name="CustomDarkDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">#2C2C2E</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#9CA3AF</item>
        <item name="colorAccent">#F59E0B</item>
        <item name="android:textColorAlertDialogListItem">#FFFFFF</item>
    </style>

    <!-- สไตล์สำหรับ Activity ที่แสดงผลแบบ Dialog (เช่น OpenVPNProxyCreds) -->
    <style name="CustomDarkDialogActivity" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">#2C2C2E</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#9CA3AF</item>
        <item name="colorAccent">#F59E0B</item>
    </style>

    <!-- สไตล์สำหรับ Popup Menu -->
    <style name="CustomDarkPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">#2C2C2E</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- สไตล์สำหรับ ListPopupWindow (Context Menu / Spinner dropdown) -->
    <style name="CustomDarkListPopup" parent="Widget.AppCompat.ListPopupWindow">
        <item name="android:popupBackground">#2C2C2E</item>
        <item name="android:dropDownListViewStyle">@style/CustomDarkDropDownList</item>
    </style>

    <!-- สไตล์รายการในเมนู dropdown -->
    <style name="CustomDarkDropDownList" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:background">#2C2C2E</item>
        <item name="android:divider">#3A3A3C</item>
        <item name="android:dividerHeight">1dp</item>
        <item name="android:listSelector">#3A3A3C</item>
    </style>

    <style name="TextAppearance.Compat.Notification" parent="@android:style/TextAppearance.StatusBar.EventContent" />
    <style name="TextAppearance.Compat.Notification.Info" parent="@style/TextAppearance.Compat.Notification">
        <item name="android:textSize">12.0sp</item>
        <item name="android:textColor">#9CA3AF</item>
    </style>
    <style name="TextAppearance.Compat.Notification.Time" parent="@style/TextAppearance.Compat.Notification">
        <item name="android:textSize">12.0sp</item>
        <item name="android:textColor">#9CA3AF</item>
    </style>
    <style name="TextAppearance.Compat.Notification.Title" parent="@android:style/TextAppearance.StatusBar.EventContent.Title" />
    <style name="Widget.Compat.NotificationActionContainer" parent="" />
    <style name="Widget.Compat.NotificationActionText" parent="" />
    <style name="TextAppearance.Compat.Notification.Line2" parent="@style/TextAppearance.Compat.Notification.Info" />
    <style name="ad_image">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="ad_layout">
        <item name="android:paddingLeft">5.0dip</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="button">
        <item name="android:textAppearance">?android:textAppearanceMedium</item>
        <item name="android:layout_width">240.0sp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="edit">
        <item name="android:textAppearance">?android:textAppearanceMedium</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:inputType">textNoSuggestions</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#6B7280</item>
    </style>
    <style name="footer">
        <item name="android:textAppearance">?android:textAppearanceSmall</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#9CA3AF</item>
    </style>

    <style name="group">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
	
    <style name="group_horizontal">
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="group_wrap">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="image">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="info_box">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="item">
        <item name="android:textAppearance">?android:textAppearanceMedium</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="item_wrap">
        <item name="android:textAppearance">?android:textAppearanceMedium</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="label">
        <item name="android:textAppearance">?android:textAppearanceMedium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="prop_image">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentTop">true</item>
        <item name="android:layout_alignParentRight">true</item>
    </style>
    <style name="prop_layout">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">fill_parent</item>
    </style>
    <style name="spacer16">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">16.0sp</item>
    </style>
    <style name="spacer8">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">8.0sp</item>
    </style>
    <style name="stats_boxed">
        <item name="android:orientation">vertical</item>
        <item name="android:background">#2C2C2E</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="stats_group">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="stats_header">
        <item name="android:textAppearance">?android:textAppearanceMedium</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#F59E0B</item>
    </style>
    <style name="stats_key">
        <item name="android:textAppearance">?android:textAppearanceSmall</item>
        <item name="android:paddingLeft">16.0sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#9CA3AF</item>
    </style>
    <style name="stats_row">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="stats_section">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="stats_table">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="stats_value">
        <item name="android:textAppearance">?android:textAppearanceSmall</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">16.0sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="subtitle">
        <item name="android:textAppearance">?android:textAppearanceSmall</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#9CA3AF</item>
    </style>
    <style name="title">
        <item name="android:textAppearance">?android:textAppearanceLarge</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>